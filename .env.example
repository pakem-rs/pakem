# ─── PAKEM FRAMEWORK CONFIGURATION ──────────────────────────────────────────

# Application Settings
APP_NAME=Pakem
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=pakem-super-secret-key-change-me-in-production

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Database Configuration (Laravel Style - Tidak perlu DATABASE_URL yang panjang!)
DB_CONNECTION=sqlite
DB_DATABASE=./database.sqlite

# Atau untuk MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pakem_db
# DB_USERNAME=root
# DB_PASSWORD=

# Atau untuk PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pakem_db
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# Opsional: Jika ingin menggunakan URL eksplisit
# DATABASE_URL=sqlite:./database.sqlite

# Rate Limiting
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# Storage Settings
UPLOAD_MAX_SIZE_MB=5

# Session Configuration
JWT_SECRET=pakem-jwt-secret-key-change-me-in-production

# ──────────────────────────────────────────────────────────────────────────────
